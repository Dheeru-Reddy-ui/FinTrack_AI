{
  "expo": {
    "name": "FinTrack AI",
    "slug": "FinTrack_AI",
    "version": "1.0.0",
    "scheme": "fintrack",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF0EA"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.dheerureddy.fintrackai",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#1FA95C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "FinTrack AI uses your photos to read receipts and UPI payment screenshots.",
          "cameraPermission": "FinTrack AI uses your camera to snap receipts and UPI payment screens.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "56e891ad-e3b5-423b-bb3f-41e3a1986d93"
      }
    }
  }
}
